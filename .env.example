# Copy this file to .env and fill in real values

PORT=3000

# Used to build the account link put in emails / QR codes.
# In production, set this to your real domain, e.g. https://yourstore.com
PUBLIC_BASE_URL=http://localhost:3000

# Secret used to sign login tokens - change this to a long random string
JWT_SECRET=change-this-to-a-long-random-string

# Database connection string (PostgreSQL)
# For Vercel: get from Vercel Postgres integration or Neon dashboard
# For local: use a local PostgreSQL instance or Neon dev branch
DATABASE_URL=postgresql://user:pass@localhost:5432/nfc_store

# SMTP settings for sending activation emails.
# Example for Gmail: use smtp.gmail.com, port 587, and a 16-character
# "App Password" (not your normal Gmail password) - you must enable
# 2-Step Verification on the Gmail account first, then create an App
# Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=youraddress@gmail.com
